{
  "name": "detective-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5183 --strictPort",
    "dev:lan": "vite --host --port 5183 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4183 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@kfonts/neodgm": "^0.5.0",
    "galmuri": "^2.40.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
